{
  "id": "invoice",
  "name": "Invoicing",
  "version": "1.2.31",
  "description": "Issue invoices from sales, mark them as paid, and issue rectifying invoices.",
  "agent": {
    "description": "Manages invoicing: create invoices from sales, issue rectifying invoices, mark invoices as paid, and manage invoice series.",
    "keywords": [
      "invoice",
      "billing",
      "receipt",
      "payment",
      "rectify",
      "series",
      "tax"
    ]
  },
  "depends_on": [
    "taxes",
    "sales"
  ],
  "permissions": [
    "invoice.view_invoice",
    "invoice.add_invoice",
    "invoice.rectify_invoice",
    "invoice.manage_series"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "invoice.view_invoice",
      "invoice.add_invoice",
      "invoice.rectify_invoice",
      "invoice.manage_series"
    ],
    "employee": [
      "invoice.view_invoice",
      "invoice.add_invoice"
    ]
  },
  "navigation": [
    {
      "id": "invoice",
      "label": "Invoices",
      "icon": "document-text-outline",
      "component": "erp-invoice-list",
      "permission": "invoice.view_invoice"
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "settings-outline",
      "component": "erp-invoice-settings",
      "permission": "invoice.manage_series"
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_tax_category_key.sql",
      "migrations/postgres/003_substitution.sql",
      "migrations/postgres/004_quantity_fixed_point.sql",
      "migrations/postgres/005_substitution_unique.sql",
      "migrations/postgres/006_line_surcharge_rate.sql",
      "migrations/postgres/007_number_allocation.sql",
      "migrations/postgres/008_series_format.sql",
      "migrations/postgres/009_rectification_unique.sql",
      "migrations/postgres/010_rectifies_ref.sql",
      "migrations/postgres/011_rectifications_per_refund.sql"
    ]
  },
  "queries": {
    "invoice.list": {
      "permission": "invoice.view_invoice",
      "expose_api": true,
      "sql": "queries/list.sql",
      "list": {
        "search": [
          "number",
          "customer_name",
          "customer_tax_id"
        ],
        "sort": [
          "id",
          "invoice_type",
          "series",
          "number",
          "issue_date",
          "customer_name",
          "customer_tax_id",
          "base_amount",
          "tax_amount",
          "total_amount",
          "status",
          "source_type"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "invoice_type": {
            "op": "eq"
          },
          "series": {
            "op": "eq"
          },
          "number": {
            "op": "eq"
          },
          "issue_date": {
            "op": "range"
          },
          "customer_name": {
            "op": "like"
          },
          "customer_tax_id": {
            "op": "range"
          },
          "base_amount": {
            "op": "range"
          },
          "tax_amount": {
            "op": "range"
          },
          "total_amount": {
            "op": "range"
          },
          "status": {
            "op": "eq"
          },
          "source_type": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists issued invoices with their main details."
      }
    },
    "invoice.get": {
      "permission": "invoice.view_invoice",
      "expose_api": true,
      "sql": "queries/get.sql",
      "ai": {
        "description": "Retrieves the full detail of an invoice by its identifier."
      }
    },
    "invoice.by_source": {
      "permission": "invoice.view_invoice",
      "expose_api": true,
      "sql": "queries/by_source.sql",
      "schema": "schemas/by_source.json",
      "ai": {
        "description": "Returns the invoice generated from a given source (e.g. a POS sale) by its source id."
      }
    },
    "invoice.lines": {
      "permission": "invoice.view_invoice",
      "expose_api": true,
      "sql": "queries/lines.sql",
      "ai": {
        "description": "Lists the line items (products/services) of an invoice."
      }
    },
    "invoice.series.list": {
      "permission": "invoice.view_invoice",
      "sql": "queries/series_list.sql",
      "list": {
        "search": [
          "code",
          "name",
          "current_number"
        ],
        "sort": [
          "id",
          "code",
          "name",
          "invoice_type",
          "year",
          "current_number",
          "prefix",
          "is_active",
          "is_default",
          "format",
          "format_locked"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "code": {
            "op": "eq"
          },
          "name": {
            "op": "like"
          },
          "invoice_type": {
            "op": "eq"
          },
          "year": {
            "op": "eq"
          },
          "current_number": {
            "op": "eq"
          },
          "prefix": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          },
          "is_default": {
            "op": "eq"
          },
          "format_locked": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the available invoice series."
      }
    },
    "invoice.series.peek_next": {
      "permission": "invoice.view_invoice",
      "expose_api": true,
      "sql": "queries/series_peek_next.sql",
      "schema": "schemas/series_peek_next.json",
      "ai": {
        "description": "Previews the next number a series would hand out WITHOUT consuming it, rendered with the series' own format template. Also reports whether the format is still editable."
      }
    },
    "invoice.numbering.allocations": {
      "permission": "invoice.view_invoice",
      "expose_api": true,
      "sql": "queries/allocations.sql",
      "list": {
        "search": [
          "document_number",
          "code"
        ],
        "sort": [
          "id",
          "code",
          "year",
          "sequence",
          "document_number",
          "invoice_id",
          "allocated_at"
        ],
        "default_sort": "sequence",
        "default_dir": "asc",
        "filters": {
          "code": {
            "op": "eq"
          },
          "year": {
            "op": "eq"
          },
          "sequence": {
            "op": "range"
          },
          "document_number": {
            "op": "eq"
          },
          "invoice_id": {
            "op": "eq"
          },
          "allocated_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the numbering book: one row per fiscal number handed out, with the series, the sequence, the rendered number and the invoice behind it."
      }
    },
    "invoice.numbering.status": {
      "permission": "invoice.view_invoice",
      "sql": "queries/numbering_status.sql",
      "ai": {
        "description": "Reports whether this hub's invoice numbering is set up for the current fiscal year: how many ordinary series (F1/F2/F3) and how many rectifying series (R1-R5) it has, whether one is the default, and how many series exist in total."
      }
    },
    "invoice.numbering.gaps": {
      "permission": "invoice.view_invoice",
      "expose_api": true,
      "sql": "queries/numbering_gaps.sql",
      "ai": {
        "description": "Reports gaps in the invoice numbering: one row per missing stretch of numbers inside a series. No rows means the numbering is correlative, which is what a tax inspection asks for."
      }
    }
  },
  "records": {
    "invoice": {
      "mutable": false,
      "reason": "fiscal",
      "correct_with": [
        "invoice.rectify"
      ]
    }
  },
  "commands": {
    "invoice.create": {
      "permission": "invoice.add_invoice",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_invoice"
      },
      "schema": "schemas/create_invoice.json",
      "ai": {
        "description": "Creates a new invoice with its detail lines."
      },
      "reads": [
        "taxes.rules.list"
      ]
    },
    "invoice.create_from_sale": {
      "permission": "invoice.add_invoice",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_from_sale"
      },
      "ai": {
        "description": "Automatically generates an invoice from a completed sale."
      },
      "reads": [
        "taxes.rules.list",
        {
          "query": "sales.get",
          "params": {
            "sale_id": "payload.sale_id"
          }
        }
      ]
    },
    "invoice.substitute": {
      "permission": "invoice.add_invoice",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "substitute_from_invoice"
      },
      "schema": "schemas/substitute.json",
      "ai": {
        "description": "Issues a complete invoice (F3) that substitutes a previously issued simplified invoice/ticket (F2) — the 'customer asks for an invoice for their ticket' case. The original ticket stays immutable; the new F3 links to it and carries the customer's tax details. Not a rectification (the ticket was correct)."
      },
      "reads": [
        "taxes.rules.list"
      ]
    },
    "invoice.rectify": {
      "permission": "invoice.rectify_invoice",
      "transaction": true,
      "sql": [
        "commands/rectify_ensure.sql",
        "commands/rectify_bump.sql",
        "commands/rectify_insert.sql",
        "commands/rectify_lines.sql",
        "commands/rectify_line_refund.sql",
        "commands/_insert_allocation.sql",
        "commands/rectify_cancel.sql"
      ],
      "emit": [
        "invoice.rectified"
      ],
      "ai": {
        "description": "Issues a rectifying invoice that cancels or corrects an existing invoice."
      }
    },
    "invoice._rectify_from_refund": {
      "permission": "invoice.rectify_invoice",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/rectify_ensure.sql",
        "commands/rectify_bump.sql",
        "commands/rectify_insert.sql",
        "commands/rectify_lines.sql",
        "commands/rectify_line_refund.sql",
        "commands/_insert_allocation.sql",
        "commands/rectify_cancel.sql"
      ],
      "emit": [
        "invoice.rectified"
      ],
      "ai": {
        "description": "Listener of `sale.refunded` (sales v2.16.4): issues the rectifying invoice for a refunded sale by itself, so the money and the fiscal document never disagree. Resolves the original from the sale. A refund of the whole invoice negates it entirely and cancels it; a refund that leaves part of it standing issues a rectificativa por diferencias (invoice#63) for the amount returned, prorated over the original's frozen tax breakdown, and the original stays issued; the act that closes the return rectifies exactly what is left, so the documents add up to the original to the cent. Idempotent by the refund document reference: the same refund twice is one document, one series number and one VeriFactu record. Internal: only the runtime's outbox relay calls it."
      }
    },
    "invoice.mark_paid": {
      "permission": "invoice.add_invoice",
      "transaction": true,
      "sql": [
        "commands/mark_paid.sql"
      ],
      "ai": {
        "description": "Marks an issued invoice as paid, recording the payment date. Amounts are immutable and no payment method is stored."
      }
    },
    "invoice.series.create": {
      "permission": "invoice.manage_series",
      "transaction": true,
      "sql": [
        "commands/series_create_clear_default.sql",
        "commands/series_create.sql"
      ],
      "schema": "schemas/series_create.json",
      "ai": {
        "description": "Creates a new invoice numbering series (code, name, invoice type, year, prefix). Marking it as default demotes the previous default series of the same year."
      }
    },
    "invoice.series.update": {
      "permission": "invoice.manage_series",
      "transaction": true,
      "sql": [
        "commands/series_update_clear_default.sql",
        "commands/series_update.sql"
      ],
      "schema": "schemas/series_update.json",
      "ai": {
        "description": "Updates the mutable fields of an invoice series (name, prefix, is_active, is_default). Code, year and the counter are immutable for fiscal integrity."
      }
    },
    "invoice._ensure_series": {
      "permission": "invoice.add_invoice",
      "sql": [
        "commands/_ensure_series.sql"
      ]
    },
    "invoice._bump_series": {
      "permission": "invoice.add_invoice",
      "sql": [
        "commands/_bump_series.sql"
      ]
    },
    "invoice._insert_invoice": {
      "permission": "invoice.add_invoice",
      "sql": [
        "commands/_insert_invoice.sql",
        "commands/_insert_allocation.sql"
      ]
    },
    "invoice._insert_line": {
      "permission": "invoice.add_invoice",
      "sql": [
        "commands/_insert_line.sql"
      ]
    }
  },
  "events": {
    "listen": {
      "sale.completed": {
        "command": "invoice.create_from_sale"
      },
      "sale.refunded": {
        "command": "invoice._rectify_from_refund"
      }
    },
    "emits": [
      "invoice.created",
      "invoice.rectified"
    ]
  },
  "setup": {
    "query": "invoice.numbering.status",
    "configured_when": [
      {
        "field": "ordinary_series",
        "truthy": true
      },
      {
        "field": "rectifying_series",
        "truthy": true
      }
    ],
    "title": "Your invoice numbering",
    "description": "Check the prefix your invoice numbers will carry, and add the separate series the tax authority requires for corrective invoices. If you are coming from another system, continue its numbering instead of starting again at 1.",
    "icon": "bookmark-outline",
    "route": "/m/invoice/settings",
    "permission": "invoice.manage_series",
    "countries": [],
    "order": 50,
    "required": true
  },
  "ui": {
    "entry": "dist/invoice.esm.js"
  }
}
