    "code": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "invoice_type": {"type": "string", "enum": ["F1", "F2", "F3", "R1", "R2", "R3", "R4", "R5"]},
    "year": {"type": "integer", "minimum": 2000, "maximum": 2999},
    "prefix": {"type": "string"},
