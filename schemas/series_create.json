{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invoice.series.create payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "invoice_type",
    "year"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "invoice_type": {
      "type": "string",
      "enum": [
        "F1",
        "F2",
        "F3",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2999
    },
    "prefix": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^(?=.*\\{seq(:0[1-9]d)?\\})[^\\n\\r]{1,60}$",
      "description": "Number template. Placeholders: {prefix}, {code}, {year}, {seq}, {seq:01d}..{seq:09d}. A sequence placeholder is REQUIRED. Omit the field to keep PREFIX-YYYY-NNNNNN. Only settable while the series has not issued anything (current_number = 0): the number goes into VeriFactu's chained fingerprint."
    },
    "is_active": {
      "type": [
        "boolean",
        "integer"
      ]
    },
    "is_default": {
      "type": [
        "boolean",
        "integer"
      ]
    }
  }
}
